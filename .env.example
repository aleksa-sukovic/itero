# Your hostname (e.g., valinor, mordor, isengard)
HOST=

# System locale
SYSTEM_LOCALE=en_US.UTF-8

# System timezone
SYSTEM_TIMEZONE=Europe/Berlin

# Directory to bind-mount at /work
ITERO_WORKDIR=

# Optional SSH destination for theme syncing (e.g., username@192.168.1.100)
ITERO_THEME_SYNC_HOST=

# Ngrok tunnel
NGROK_AUTHTOKEN=
NGROK_URL=

# Git configuration
GIT_USERNAME="Aleksa Šuković"
GIT_EMAIL=

# External monitor brightness shortcuts
BRIGHTNESS_KEY_UP="<Super>MonBrightnessUp"
BRIGHTNESS_KEY_DOWN="<Super>MonBrightnessDown"
