// This configuration is merged with the default vicinae configuration file, obtainable by the `vicinae config default` command.
// Every item defined in this file takes precedence over the values defined in the default config or any other imported file.
// See also the official docs at https://docs.vicinae.com/config.
{
   "$schema": "https://vicinae.com/schemas/config.json",
   "close_on_focus_loss": false,
    "telemetry": {
      "system_info": false
   },
   "font": {
      "normal": {
         "size": 10
      }
   },
    "theme": {
       "light": {
          "name": "{{ vicinae_theme }}",
          "icon_theme": "Adwaita"
       },
       "dark": {
          "name": "{{ vicinae_theme }}",
          "icon_theme": "Adwaita"
       }
    },
   "launcher_window": {
      "opacity": 1
   },
   "favorites": [],
   "providers": {
      "@brpaz/store.vicinae.gnome-dnd": {
         "entrypoints": {
            "toggle": {
               "alias": "dnd"
            }
         }
      },
     "@ShyAssassin/store.vicinae.vscode-recents": {
         "entrypoints": {
            "open-recents": {
               "alias": "Visual Studio Code - Recents"
            }
         }
      },
      "@dagimg-dot/store.vicinae.wifi-commander": {
         "preferences": {
            "network-cli-tool": "nmcli"
         }
      },
      "browser-extension": {
         "enabled": false
      },
      "applications": {
         "preferences": {
            "defaultAction": "focus",
            "paths": [
               "/home/{{ $USER }}/.local/share/applications",
               "/var/lib/flatpak/exports/share/applications",
               "/usr/local/share/applications",
               "/usr/share/applications"
            ]
         }
      },
      "clipboard": {
         "enabled": true,
         "preferences": {
            "ignorePasswords": false,
            "monitoring": true
         }
      },
      "core": {
         "enabled": true,
         "entrypoints": {
            "list-extensions": {
               "enabled": true
            },
            "manage-fallback": {
               "enabled": false
            },
            "open-config-file": {
               "enabled": true
            },
            "reload-scripts": {
               "enabled": false
            },
            "report-bug": {
               "enabled": false
            },
            "search-emojis": {
               "enabled": false
            },
            "sponsor": {
               "enabled": false
            }
         }
      },
      "developer": {
         "enabled": false
      },
      "files": {
         "enabled": false
      },
      "manage-shortcuts": {
         "enabled": false
      },
      "raycast-compat": {
         "enabled": false
      },
      "snippets": {
         "enabled": false
      },
      "system": {
         "enabled": false
      },
      "theme": {
         "enabled": false
      },
      "wm": {
         "enabled": false
      },
      "power": {
         "entrypoints": {
            "power-off": {
               "alias": "Shut Down"
            },
            "reboot": {
               "alias": "Restart"
            },
            "hibernate": {
               "enabled": false
            },
            "sleep": {
               "enabled": false
            },
            "soft-reboot": {
               "enabled": false
            },
            "suspend": {
               "enabled": false
            }
         }
      }
   }
}
