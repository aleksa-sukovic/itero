#!/bin/bash
set -e

ITERO_PATH="${ITERO_PATH:-$HOME/.local/share/itero}"

usage() {
    echo "Usage: itero-update [--firmware]"
    echo ""
    echo "Update system, Flatpak, Homebrew, and globally configured Mise packages."
    echo ""
    echo "Options:"
    echo "  --firmware    Also check for and install firmware updates"
    echo "  --help, -h    Show this help message"
}

update_firmware=false

case "${1:-}" in
    "") ;;
    --firmware) update_firmware=true ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        echo "Unknown option: $1" >&2
        usage >&2
        exit 1
        ;;
esac

source "$ITERO_PATH/lib/helpers.sh"

if is_linux; then
    log_info "Updating system packages..."
    sudo dnf upgrade --refresh

    if command_exists flatpak; then
        log_info "Updating Flatpak applications..."
        flatpak update
    fi
elif ! is_macos; then
    log_warn "itero-update supports Linux and macOS only"
    exit 1
fi

if command_exists brew; then
    log_info "Updating Homebrew packages..."
    brew update
    HOMEBREW_NO_AUTO_UPDATE=1 brew upgrade
elif is_macos; then
    log_warn "Homebrew is unavailable; skipping Homebrew packages"
fi

if command_exists mise; then
    log_info "Updating globally configured Mise tools..."
    mise upgrade --global --no-prune
else
    log_warn "Mise is unavailable; skipping Mise tools"
fi

if [ "$update_firmware" = true ]; then
    if ! is_linux; then
        log_warn "Firmware updates are supported on Linux only; skipping firmware updates"
    elif command_exists fwupdmgr; then
        log_info "Checking for firmware updates..."
        fwupdmgr refresh --force
        fwupdmgr update
    else
        log_warn "fwupdmgr is not installed; skipping firmware updates"
    fi
fi

log_ok "System update complete"
