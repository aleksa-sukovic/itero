#!/bin/bash

ITERO_PATH="${ITERO_PATH:-$HOME/.local/share/itero}"

usage() {
    echo "Usage: itero-theme-watch"
    echo ""
    echo "Watch GNOME appearance changes and reapply the active Itero theme."
    echo ""
    echo "Options:"
    echo "  --help, -h    Show this help message"
}

watch_setting() {
    gsettings monitor "$1" "$2" | while read -r _key _value; do
        "$ITERO_PATH/bin/itero-theme"
    done
}

cleanup() {
    kill "${watchers[@]}" 2>/dev/null || true
}

case "${1:-}" in
    --help|-h)
        usage
        exit 0
        ;;
    "") ;;
    *)
        usage
        exit 1
        ;;
esac

watchers=()

watch_setting org.gnome.desktop.interface accent-color &
watchers+=("$!")

watch_setting org.gnome.shell.extensions.itero-wm corner-radius &
watchers+=("$!")

trap cleanup EXIT
trap "exit 0" INT TERM

wait -n "${watchers[@]}"
exit 1
