#!/bin/bash

# Control an external monitor through DDC/CI

BRIGHTNESS_STEP=10
BRIGHTNESS_MIN=1
BRIGHTNESS_MAX=100

cache_dir="${XDG_RUNTIME_DIR:-/tmp}/itero-monitor-$UID"
bus_cache="$cache_dir/bus"
brightness_lock="$cache_dir/brightness.lock"

usage() {
    echo "Usage: itero-monitor <command> [option]"
    echo ""
    echo "Control a single external monitor through DDC/CI."
    echo ""
    echo "Commands:"
    echo "  brightness --up|--down  Adjust brightness by ${BRIGHTNESS_STEP}%"
    echo "  brightness --max        Set brightness to ${BRIGHTNESS_MAX}%"
    echo "  brightness --min        Set brightness to ${BRIGHTNESS_MIN}%"
    echo "  input --list            List available input sources"
    echo "  input <source>          Switch to an input source from --list"
    echo "  detect                  Show DDC/CI display detection results"
    echo "  --help, -h              Show this help message"
}

# Return the cached I2C bus or detect the single external display.
get_monitor_bus() {
    local bus
    local buses

    if ! command -v ddcutil > /dev/null; then
        echo "Error: ddcutil is not installed" >&2
        return 1
    fi

    if [ -r "$bus_cache" ]; then
        read -r bus < "$bus_cache"

        if [[ "$bus" =~ ^[0-9]+$ ]]; then
            echo "$bus"
            return 0
        fi

        rm -f "$bus_cache"
    fi

    mapfile -t buses < <(
        ddcutil --skip-ddc-checks detect --brief 2> /dev/null | awk '
            /^Display [0-9]+$/ { in_display = 1; next }
            /^Invalid display$/ { in_display = 0 }
            in_display && /I2C bus:/ {
                sub(".*/dev/i2c-", "")
                print
                in_display = 0
            }
        '
    )

    if [ "${#buses[@]}" -eq 0 ]; then
        echo "Error: no external display detected via DDC/CI" >&2
        return 1
    fi

    if [ "${#buses[@]}" -gt 1 ]; then
        echo "Error: multiple external displays detected; monitor selection is not supported yet" >&2
        return 1
    fi

    mkdir -p "$cache_dir"
    printf '%s\n' "${buses[0]}" > "$bus_cache"
    echo "${buses[0]}"
}

# Set a VCP feature and invalidate the cached bus on failure.
set_vcp() {
    local bus="$1"
    shift

    if ddcutil --bus "$bus" \
        --skip-ddc-checks \
        --noverify \
        --sleep-multiplier 0.1 \
        setvcp "$@"; then
        return 0
    fi

    rm -f "$bus_cache"
    return 1
}

# List the input sources reported by the monitor capabilities string.
list_input_sources() {
    local bus="$1"
    local capabilities

    if ! capabilities="$(ddcutil capabilities --bus "$bus" 2> /dev/null)"; then
        echo "Error: failed to read monitor capabilities" >&2
        return 1
    fi

    printf '%s\n' "$capabilities" | awk '
        /Feature: 60 \(Input Source\)/ { in_input_source = 1; next }
        in_input_source && /^   Feature:/ { exit }
        in_input_source && /^[[:space:]]+[[:xdigit:]][[:xdigit:]]:/ {
            code = $1
            sub(":", "", code)
            $1 = ""
            sub(/^[[:space:]]+/, "")
            label = $0

            if (label == "Unrecognized value") {
                label = "Input 0x" code
            }

            print "0x" tolower(code) "\t" label
        }
    '
}

adjust_brightness() {
    local direction="$1"
    local bus
    local lock_fd
    local -a value_args

    case "$direction" in
        --up) value_args=("+" "$BRIGHTNESS_STEP") ;;
        --down) value_args=("-" "$BRIGHTNESS_STEP") ;;
        --max) value_args=("$BRIGHTNESS_MAX") ;;
        --min) value_args=("$BRIGHTNESS_MIN") ;;
        *)
            echo "Error: brightness expects --up, --down, --max, or --min" >&2
            return 1
            ;;
    esac

    mkdir -p "$cache_dir"
    exec {lock_fd}> "$brightness_lock"
    flock -n "$lock_fd" || return 0

    bus="$(get_monitor_bus)" || return 1
    set_vcp "$bus" 10 "${value_args[@]}"
}

switch_input() {
    local requested_source="$1"
    local bus
    local source

    source="${requested_source,,}"
    source="0x${source#0x}"

    if [[ ! "$source" =~ ^0x[[:xdigit:]][[:xdigit:]]$ ]]; then
        echo "Error: invalid input source '$requested_source'" >&2
        return 1
    fi

    bus="$(get_monitor_bus)" || return 1

    if ! list_input_sources "$bus" | cut -f1 | grep -Fxq "$source"; then
        echo "Error: input source '$source' is not reported by this monitor" >&2
        return 1
    fi

    # N.B. Some LG monitors ignore VCP 0x60 writes; see https://github.com/rockowitz/ddcutil/issues/100
    set_vcp "$bus" 60 "$source"
}

case "${1:-}" in
    brightness)
        adjust_brightness "${2:-}"
        ;;
    input)
        case "${2:-}" in
            --list)
                bus="$(get_monitor_bus)" || exit 1
                list_input_sources "$bus"
                ;;
            "")
                echo "Error: input expects --list or a source code" >&2
                exit 1
                ;;
            *)
                switch_input "$2"
                ;;
        esac
        ;;
    detect)
        ddcutil detect
        ;;
    --help|-h|"")
        usage
        ;;
    *)
        echo "Error: unknown command '$1'" >&2
        usage >&2
        exit 1
        ;;
esac
